# Connection to the Postgres used by the postgres test modes (npm run test:pg, db-matrix).
# Copy to .env.test. Only TEST_DATABASE_URL is read from this file; which database the tests use
# is chosen by the command that runs them, not here.
#
# The Postgres from docker-compose.yml (docker compose up --wait): data in RAM, port 5433.
# The user needs CREATEDB; the database in the URL is used for admin connections.
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5433/postgres
