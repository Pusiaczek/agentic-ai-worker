{
  "name": "test-aw",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "test": "vitest run",
    "test:truncate": "vitest run --mode pglite-truncate",
    "test:pg": "vitest run --mode postgres",
    "test:pg:truncate": "vitest run --mode postgres-truncate",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "format": "biome check --write",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@fastify/ajv-compiler": "^4.0.6",
    "@fastify/type-provider-typebox": "^6.1.0",
    "drizzle-orm": "^0.45.3",
    "fastify": "^5.12.5",
    "pg": "^8.23.0",
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
